# Copy to .env.local (dev) or set in Netlify → Site settings → Environment variables
VITE_ENDPOINT=                # Google Apps Script web-app /exec URL
VITE_TURNSTILE_SITE_KEY=      # Cloudflare Turnstile site key
VITE_IG_EMBED_SRC=            # e.g. https://w.behold.so/widget.js
VITE_IG_EMBED_HTML=           # e.g. <behold-widget feed-id="…"></behold-widget>
VITE_IG_PROFILE_URL=https://www.instagram.com/
